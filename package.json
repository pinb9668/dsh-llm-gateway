{
  "name": "@chenzhao/dsh-llm-gateway",
  "version": "1.1.0",
  "type": "module",
  "description": "Local OpenAI-compatible gateway that exposes every model registered on the DSH llm service (DeepSeek, WorkBuddy, our-free-model) so external clients such as Codex can use them.",
  "author": "chenzhao",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "LICENSE",
    "README.md",
    "build-dsh-catalog.cjs",
    "tests"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/pcbaby/dsh-llm-gateway.git"
  },
  "homepage": "https://gitee.com/pcbaby/dsh-llm-gateway#readme",
  "engines": {
    "node": ">=22.14.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "openai-compatible",
    "gateway",
    "codex",
    "workbuddy"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node tests/stream-failure.mjs"
  }
}
